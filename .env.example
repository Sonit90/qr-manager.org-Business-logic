# =============================================================================
# qr-api environment configuration
# Copy to .env and adjust. Used by both native (`cargo run`) and Docker stack.
# =============================================================================

# ---- App ---------------------------------------------------------------------
# development → pretty tracing + permissive CORS
# production  → JSON tracing + strict CORS allowlist
APP_ENV=development
RUST_LOG=info,qr_api=debug,sqlx=warn

# ---- Database ----------------------------------------------------------------
# Native run (`cargo run`) reads DATABASE_URL — use localhost.
DATABASE_URL=postgresql://auth_user:auth_password@localhost:5434/auth_db
# Docker stack uses DOCKER_DB_URL — inside containers, `localhost` is the
# container itself. Use host.docker.internal to reach auth's Postgres on host.
DOCKER_DB_URL=postgresql://auth_user:auth_password@host.docker.internal:5434/auth_db

# ---- Server (native run) -----------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
# Server bind/port inside docker container
DOCKER_SERVER_HOST=0.0.0.0
DOCKER_SERVER_PORT=3001
# Host port that maps to qr-api container's 3001
QR_API_HOST_PORT=3001
QR_API_CONTAINER_NAME=qr-api
QR_API_IMAGE=qr-api
QR_API_IMAGE_TAG=local

# ---- Auth (must match rust-generic-user-backend) -----------------------------
APP__AUTH__JWT_SECRET=change-this-in-production
APP__AUTH__JWT_ISSUER=generic-auth
APP__AUTH__JWT_ACCESS_TTL_MIN=30
APP__AUTH__JWT_REFRESH_TTL_DAYS=14

# ---- CORS (production only; dev uses permissive) -----------------------------
APP__CORS__ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ---- Object storage (RustFS / S3-compatible) ---------------------------------
# Native run: point to docker-published port (localhost)
APP__STORAGE__ENDPOINT_URL=http://localhost:9000
# Docker stack: qr-api reaches rustfs via service name on internal network
DOCKER_STORAGE_ENDPOINT_URL=http://rustfs:9000

APP__STORAGE__BUCKET=qr-images
APP__STORAGE__REGION=us-east-1
# Public URL prefix exposed in API responses (client-facing)
APP__STORAGE__PUBLIC_BASE_URL=http://localhost:9000/qr-images

# RustFS root credentials. Used by both rustfs container AND qr-api
# (qr-api logs in with these as ACCESS_KEY/SECRET_KEY).
RUSTFS_ROOT_USER=rustfsadmin
RUSTFS_ROOT_PASSWORD=rustfsadmin
RUSTFS_IMAGE_TAG=latest
RUSTFS_CONTAINER_NAME=qr-rustfs
RUSTFS_INIT_CONTAINER_NAME=qr-rustfs-init
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Bucket-init helper image (minio mc)
MC_IMAGE_TAG=latest

# ---- QR redirect / frontend --------------------------------------------------
DISABLED_QR_FRONTEND_URL=http://localhost:3000/qr-disabled
REDIRECT_BASE_URL=http://localhost:3001/r

# ---- Native-run access key/secret (read by AppConfig::from_env) -------------
# When running natively, app reads these directly. Same values as RUSTFS_ROOT_*.
APP__STORAGE__ACCESS_KEY=rustfsadmin
APP__STORAGE__SECRET_KEY=rustfsadmin
