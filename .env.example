# App environment (development | production)
# - development: pretty tracing output
# - production: JSON tracing output
APP_ENV=development

# Logging
RUST_LOG=info,qr_api=debug,sqlx=warn

# Database (shared Postgres with auth service)
# qr-api owns the `qr` schema; auth service owns the `auth` schema
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/shared

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# Auth (must match rust-generic-user-backend config)
APP__AUTH__JWT_SECRET=change-this-in-production
APP__AUTH__JWT_ISSUER=generic-auth
APP__AUTH__JWT_ACCESS_TTL_MIN=30
APP__AUTH__JWT_REFRESH_TTL_DAYS=14

# QR redirect / frontend
DISABLED_QR_FRONTEND_URL=http://localhost:3000/qr-disabled
REDIRECT_BASE_URL=http://localhost:3001/r
